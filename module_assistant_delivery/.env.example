# Copy to module_assistant_delivery/.env (git-ignored). Put the real key only in .env, never in this file or in chat.
AI_HOST=127.0.0.1
AI_PORT=8003

# Local assistant: the module's private Ollama (scripts/start_ollama.ps1), OpenAI-compatible endpoint.
ASSISTANT_BASE_URL=http://127.0.0.1:11435/v1
ASSISTANT_MODEL=qwen2.5:7b-instruct
ASSISTANT_TIMEOUT_S=60

# Hosted API (owner decision): delivery review + assistant fallback when the local model fails.
# Groq free tier is the candidate (OpenAI-compatible). Evaluations always disable the fallback themselves.
HOSTED_API_BASE_URL=https://api.groq.com/openai/v1
HOSTED_API_KEY=
ASSISTANT_BACKUP_ENABLED=true
BACKUP_MODEL=openai/gpt-oss-120b
REVIEW_PROVIDER=hosted
REVIEW_MODEL=openai/gpt-oss-120b
HOSTED_REASONING_EFFORT=low
HOSTED_TIMEOUT_S=60
REVIEW_TIMEOUT_S=180

# Embeddings (CPU). The model must have a profile in backend/app/rag/embeddings.py.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_K=5

# Storage (relative paths are inside module_assistant_delivery/)
DATABASE_PATH=storage/assistant.sqlite3
CHROMA_PATH=storage/chroma
