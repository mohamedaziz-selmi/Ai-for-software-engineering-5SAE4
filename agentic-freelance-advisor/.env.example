# Copy to .env and fill in. Never commit .env.
# An empty value (KEY=) counts as "not set".

# --- Local LLM (Ollama) -------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Recommended (measured): qwen3:4b-instruct, a NON-thinking model: a full run takes ~3 minutes.
# Alternative: qwen3:4b (thinking-only build) with OLLAMA_REASONING=true: 13-22 minutes and cut-off calls.
OLLAMA_MODEL=qwen3:4b-instruct
# Context window per request. Measured on an RTX 2050 (4 GB VRAM): 4096 -> 67% on GPU,
# 8192 -> 58% on GPU and ~25% slower. Raise it only if you have more VRAM.
OLLAMA_NUM_CTX=4096
# 0.6 is the model's own default; thinking models degrade at near-greedy temperatures.
OLLAMA_TEMPERATURE=0.6
# false for qwen3:4b-instruct. true for qwen3:4b (thinking-only build: false does not disable its thinking and
# leaks it into the answer text). Write it explicitly: an empty value means the default, which is true.
OLLAMA_REASONING=false
# Seconds allowed for one LLM call.
OLLAMA_REQUEST_TIMEOUT=300
# GPU layers. Measured on an RTX 2050 (4 GB): Ollama's own choice = 67% on GPU, 17 tok/s;
# 99 (all layers) = 100% on GPU, 32 tok/s, 3.2 GB VRAM. Use -1 to let Ollama decide.
OLLAMA_NUM_GPU=99
# Max generated tokens per agent turn, thinking included. Too low cuts the model off mid-thought.
AGENT_MAX_TOKENS=1600
# Cap for the one-off plan call (tiny prompt, so it can be large).
PLAN_MAX_TOKENS=2000
# Same cap for each LLM-written report section.
REPORT_MAX_TOKENS=2000

# --- Research tool keys -------------------------------------------------------
# Tavily (web search). REQUIRED for the web_search tool.
# Free tier: 1,000 credits/month, no credit card. https://app.tavily.com
TAVILY_API_KEY=

# GitHub token. Optional but recommended: search allows 30 requests/min with a token
# and 10/min without. Fine-grained token, public repositories only, no extra permissions.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Hugging Face token. Expected to be optional for public dataset metadata
# (confirmed in Phase 2). https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Agent limits -------------------------------------------------------------
MAX_ITERATIONS=6
MAX_TOOL_CALLS=8
MAX_CALLS_PER_ROUND=2
# Times the evaluator may send the agent back to research after it said DONE with gaps open.
MAX_GAP_NUDGES=2
TOOL_TIMEOUT_SECONDS=20
MAX_RESULTS_PER_TOOL=5
# en = leave out datasets in other languages (unless the query names one); any = no language filter
DATASET_LANGUAGE=en
# Tavily results scoring below this are dropped (the two best are always kept)
WEB_MIN_RELEVANCE=0.3
# Whole run, seconds. Research stops at 50% of it so the report can still be written.
RUN_TIMEOUT_SECONDS=1800

# --- API ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# JSON list. Default allows the Vite dev server of the front end (port 8766).
# CORS_ORIGINS=["http://localhost:8766","http://127.0.0.1:8766"]
